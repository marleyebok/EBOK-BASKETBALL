---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardShell from '../../components/DashboardShell.astro';
---

<BaseLayout
  title="Mon profil — EBOK Basketball"
  description="Ton profil EBOK, valable sur toute la galaxie."
>
  <DashboardShell current="profil">
    <div class="dash-head">
      <h1>Mon profil</h1>
      <p class="dash-crumb">Compte · Profil — ces infos sont valables sur toute la galaxie EBOK.</p>
    </div>

    <div class="dash-error" data-error hidden></div>

    {/* Chargé côté navigateur (site statique) — voir le script en bas. */}
    <div class="dash-card" data-loading>
      <p class="dash-muted">Chargement de ton profil…</p>
    </div>

    {/* Profil déjà rempli : affichage en lecture seule. */}
    <div class="dash-card" data-filled hidden>
      <dl class="dash-dl" data-rows></dl>
    </div>

    {/* Questionnaire pas encore rempli. */}
    <div class="dash-card" data-empty hidden>
      <p style="margin-top:0"><strong>Ton profil n'est pas encore rempli.</strong></p>
      <p class="dash-muted">
        Quelques questions rapides pour personnaliser ton compte sur toute la galaxie.
      </p>
      <a class="dash-btn" href="/onboarding" style="margin-top:6px">Remplir mon profil</a>
    </div>

    <p class="dash-muted" data-edit hidden>
      Pour modifier ces informations, refais le questionnaire →{' '}
      <a href="/onboarding" style="color:var(--d-accent);font-weight:600">Modifier mon profil</a>.
    </p>

    <p class="dash-muted" style="margin-top:16px">
      Nom, e-mail, mot de passe ou suppression du compte →{' '}
      <a href="/compte/general" style="color:var(--d-accent);font-weight:600">Général</a>.
    </p>
  </DashboardShell>
</BaseLayout>

<script>
  import type { Clerk } from '@clerk/clerk-js';

  const loading = document.querySelector<HTMLElement>('[data-loading]')!;
  const filled = document.querySelector<HTMLElement>('[data-filled]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const editNote = document.querySelector<HTMLElement>('[data-edit]')!;
  const rowsEl = document.querySelector<HTMLElement>('[data-rows]')!;
  const errorEl = document.querySelector<HTMLElement>('[data-error]')!;

  /** Le shell prévient dès que Clerk est prêt et l'utilisateur connecté. */
  document.addEventListener('ebok:dash-ready', (async (event: CustomEvent<{ clerk: Clerk }>) => {
    const token = (await event.detail.clerk.session?.getToken()) ?? '';

    try {
      const res = await fetch('/api/profile', { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error(String(res.status));

      const { filled: isFilled, rows } = (await res.json()) as {
        filled: boolean;
        rows: { label: string; value: string }[];
      };

      loading.hidden = true;
      if (!isFilled || rows.length === 0) {
        empty.hidden = false;
        return;
      }

      // `textContent` plutôt que du HTML : ces valeurs viennent du membre.
      for (const row of rows) {
        const dt = document.createElement('dt');
        dt.textContent = row.label;
        const dd = document.createElement('dd');
        dd.textContent = row.value;
        rowsEl.append(dt, dd);
      }
      filled.hidden = false;
      editNote.hidden = false;
    } catch {
      loading.hidden = true;
      errorEl.textContent = 'Impossible de charger ton profil pour le moment.';
      errorEl.hidden = false;
    }
  }) as unknown as EventListener);
</script>
