---
/** Header : logo centré, contrôles de compte en haut à droite. */
import Logo from './Logo.astro';
import AuthControls from './AuthControls.astro';
import { currentLang, useT } from '../i18n';

const lang = currentLang(Astro.currentLocale);
const t = useT(lang);
---

<header class="site-header">
  <a href="/" aria-label={t('nav.home')}>
    <Logo />
  </a>
  <AuthControls />
</header>
