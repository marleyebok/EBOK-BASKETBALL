---
/**
 * Contrôles de compte EBOK (Clerk) pour le site mère statique.
 *
 * Le site est 100 % statique : Clerk tourne donc entièrement côté navigateur
 * via `@clerk/clerk-js`. La clé publiable (non secrète) est lue à la compilation
 * depuis `PUBLIC_CLERK_PUBLISHABLE_KEY` (voir `.env.example`).
 *
 * - Déconnecté : boutons « Se connecter » et « Créer un compte » (modales Clerk).
 * - Connecté   : avatar Clerk (`UserButton`) avec menu profil / déconnexion.
 *
 * SSO galaxie : en production, l'instance Clerk est le domaine principal
 * `ebok.fr` ; le cookie de session posé sur `.ebok.fr` est partagé par tous les
 * sous-domaines (video.ebok.fr, event.ebok.fr…). Rien à configurer ici : la clé
 * publiable encode l'API frontend. Voir `docs/AUTH.md`.
 */
import { currentLang, useT } from '../i18n';

const lang = currentLang(Astro.currentLocale);
const t = useT(lang);
---

<nav class="auth" aria-label={t('auth.aria')} data-hidden>
  <div class="auth-out" hidden>
    <button type="button" class="auth-btn auth-signin">{t('auth.signin')}</button>
    <button type="button" class="auth-btn auth-primary auth-signup">{t('auth.signup')}</button>
  </div>
  <div class="auth-in" hidden>
    <div class="auth-user"></div>
  </div>
</nav>

<script>
  import { Clerk } from '@clerk/clerk-js';

  // Clé publiable de l'instance de production partagée de la galaxie
  // (clerk.ebok.fr). Elle est PUBLIQUE (déjà utilisée par les autres apps EBOK),
  // donc câblée ici en valeur par défaut pour que le compte fonctionne d'office.
  // On peut la surcharger via PUBLIC_CLERK_PUBLISHABLE_KEY (ex. instance de test).
  const DEFAULT_PUBLISHABLE_KEY = 'pk_live_Y2xlcmsuZWJvay5mciQ';
  const PUBLISHABLE_KEY =
    (import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY as string | undefined) ||
    DEFAULT_PUBLISHABLE_KEY;

  const root = document.querySelector<HTMLElement>('.auth');
  if (!root) {
    // Rien à faire (composant absent de la page).
  } else if (!PUBLISHABLE_KEY) {
    // Clé absente : on laisse les contrôles masqués plutôt que d'afficher des
    // boutons morts. À brancher via PUBLIC_CLERK_PUBLISHABLE_KEY (voir .env.example).
    console.warn(
      '[EBOK] Clerk désactivé : définis PUBLIC_CLERK_PUBLISHABLE_KEY pour activer le compte.'
    );
  } else {
    const out = root.querySelector<HTMLElement>('.auth-out')!;
    const inn = root.querySelector<HTMLElement>('.auth-in')!;
    const userEl = root.querySelector<HTMLElement>('.auth-user')!;
    const signInBtn = root.querySelector<HTMLElement>('.auth-signin')!;
    const signUpBtn = root.querySelector<HTMLElement>('.auth-signup')!;

    const localizationPromise = import('@clerk/localizations').then((m) => m.frFR);

    // Domaine Frontend API Clerk (`clerk.ebok.fr`), dérivé de la clé publiable
    // (segment base64 entre le 2e et 3e « _ », sans le `$` final).
    const clerkDomain = atob(PUBLISHABLE_KEY.split('_')[2]).slice(0, -1);

    // `@clerk/clerk-js` seul ne suffit pas pour les modales (SignIn/SignUp/
    // UserButton) : il faut aussi charger le bundle UI séparé et le passer
    // explicitement à `.load()` — sans ça, Clerk se charge « en mode headless »
    // et toute tentative d'ouvrir une modale échoue avec « Clerk was not loaded
    // with Ui components ». C'était la vraie cause du bouton sans effet (le
    // 403 d'allowlist masquait ce problème derrière un autre).
    const win = window as typeof window & { __internal_ClerkUICtor?: any };
    const uiScriptPromise = new Promise<void>((resolve, reject) => {
      if (win.__internal_ClerkUICtor) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = `https://${clerkDomain}/npm/@clerk/ui@1/dist/ui.browser.js`;
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Échec du chargement du bundle UI Clerk'));
      document.head.appendChild(script);
    });

    // `clerk` est réaffectable : une instance dont le `.load()` reste bloqué
    // (réseau coupé, bloqueur de pub…) ne « retente » jamais rien en interne
    // si on rappelle `.load()` dessus — aucune nouvelle requête ne part, elle
    // reste juste éternellement en attente. Le seul moyen de vraiment
    // relancer un essai est de repartir sur une instance Clerk toute neuve.
    let clerk = new Clerk(PUBLISHABLE_KEY);
    let clerkReady = false;
    let renderSetUp = false;
    let loadAttempt: Promise<void> | null = null;

    function setupRenderOnce() {
      if (renderSetUp) return;
      renderSetUp = true;
      let userMounted = false;
      const render = () => {
        const signedIn = Boolean(clerk.user);
        out.hidden = signedIn;
        inn.hidden = !signedIn;
        if (signedIn && !userMounted) {
          clerk.mountUserButton(userEl);
          userMounted = true;
        } else if (!signedIn && userMounted) {
          clerk.unmountUserButton(userEl);
          userMounted = false;
        }
      };
      render();
      clerk.addListener(render);
    }

    // Charge Clerk à la demande, avec un timeout explicite (8s). Si ce délai
    // est dépassé, on repart sur une INSTANCE FRAÎCHE au prochain appel
    // (`loadAttempt` remis à zéro) plutôt que de rappeler `.load()` sur
    // l'instance bloquée — c'était la cause du bouton « Créer un compte »
    // resté définitivement sans effet après un premier échec réseau.
    function ensureClerkLoaded(): Promise<void> {
      if (clerkReady) return Promise.resolve();
      if (!loadAttempt) {
        const attempt = Promise.all([localizationPromise, uiScriptPromise])
          .then(([localization]) =>
            clerk.load({ localization, ui: { ClerkUI: win.__internal_ClerkUICtor } })
          )
          .then(() => {
            clerkReady = true;
            setupRenderOnce();
          });
        const attemptTimeout = new Promise<void>((_, reject) =>
          setTimeout(() => reject(new Error('Clerk : délai de chargement dépassé')), 8000)
        );
        loadAttempt = Promise.race([attempt, attemptTimeout]).catch((err) => {
          console.error('[EBOK] Échec du chargement de Clerk :', err);
          loadAttempt = null; // permet un nouvel essai au prochain clic
          clerk = new Clerk(PUBLISHABLE_KEY); // instance neuve pour ce prochain essai
          throw err;
        });
      }
      return loadAttempt;
    }

    // Retour visuel pendant l'attente (jusqu'à 8s en cas de souci réseau) :
    // sans ça, un bouton qui ne réagit pas tout de suite donne l'impression
    // de ne rien faire.
    async function withLoadingState(btn: HTMLElement, action: () => void) {
      const original = btn.textContent;
      btn.setAttribute('aria-busy', 'true');
      btn.textContent = '…';
      try {
        await ensureClerkLoaded();
        action();
      } catch {
        // Échec malgré la tentative : le clic suivant en relancera une autre.
      } finally {
        btn.removeAttribute('aria-busy');
        btn.textContent = original;
      }
    }

    // `oauthFlow: 'popup'` : Google (et les autres providers OAuth) restent
    // dans une popup plutôt qu'une redirection plein écran — la session est
    // déjà active côté client au moment où Clerk applique la redirection.
    signInBtn.addEventListener('click', () =>
      withLoadingState(signInBtn, () => clerk.openSignIn({ oauthFlow: 'popup' }))
    );
    // Après inscription : questionnaire de bienvenue (une seule fois par
    // compte, quelle que soit l'app où l'inscription a eu lieu).
    signUpBtn.addEventListener('click', () =>
      withLoadingState(signUpBtn, () =>
        clerk.openSignUp({ forceRedirectUrl: '/onboarding', oauthFlow: 'popup' })
      )
    );

    // Premier essai automatique au chargement de la page. Ne jamais laisser
    // les boutons invisibles en silence : on les révèle après 6s dans tous
    // les cas (même en échec, en état déconnecté — un clic relancera Clerk).
    const firstAttempt = ensureClerkLoaded().catch(() => {
      out.hidden = false;
      inn.hidden = true;
    });
    const timeout = new Promise<void>((resolve) => setTimeout(resolve, 6000));
    await Promise.race([firstAttempt, timeout]);
    root.removeAttribute('data-hidden'); // révèle les contrôles dans tous les cas
  }
</script>
